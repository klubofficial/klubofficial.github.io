const SECOND_HYPHEN_LOCATION = 7
const MAX_LENGTH = 11 

export const formatLikePhoneNumber  = (value: string) => {
  if (/[0-9]{3}-[0-9]{4}-[0-9]{4}/.test(value)) return value

  const numberString = value.replaceAll(/[^0-9]|-/g, '')
  if (numberString.length > MAX_LENGTH) {
    return numberString.slice(0, MAX_LENGTH).replace(/(^[0-9]{3})([0-9]{4})([0-9])/, '$1-$2-$3')
  }
  if (numberString.length > SECOND_HYPHEN_LOCATION) {
    return numberString.replace(/(^[0-9]{3})([0-9]{4})([0-9]+)/, '$1-$2-$3')
  }
  return numberString.replace(/(^[0-9]{3})([0-9]+)/, '$1-$2')
}
